; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="wuxia"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.5")
config/icon="res://assets/icons/icon.svg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
DataManager="*res://scripts/autoload/data_manager.gd"

[input]

ui_select={
"deadzone": 0.5,
"events": [{
"keycode": 32,
"type": "Key"
}, {
"button_index": 0,
"type": "JoyButton"
}]
}
ui_cancel={
"deadzone": 0.5,
"events": [{
"keycode": 16777217,
"type": "Key"
}, {
"button_index": 1,
"type": "JoyButton"
}]
}
ui_focus_next={
"deadzone": 0.5,
"events": [{
"keycode": 65289,
"type": "Key"
}]
}
ui_focus_prev={
"deadzone": 0.5,
"events": [{
"keycode": 65289,
"shift": true,
"type": "Key"
}]
}
ui_left={
"deadzone": 0.5,
"events": [{
"keycode": 65,
"type": "Key"
}, {
"button_index": 13,
"type": "JoyButton"
}]
}
ui_right={
"deadzone": 0.5,
"events": [{
"keycode": 68,
"type": "Key"
}, {
"button_index": 14,
"type": "JoyButton"
}]
}
ui_up={
"deadzone": 0.5,
"events": [{
"keycode": 87,
"type": "Key"
}, {
"button_index": 11,
"type": "JoyButton"
}]
}
ui_down={
"deadzone": 0.5,
"events": [{
"keycode": 83,
"type": "Key"
}, {
"button_index": 12,
"type": "JoyButton"
}]
}
ui_page_up={
"deadzone": 0.5,
"events": [{
"keycode": 65365,
"type": "Key"
}]
}
ui_page_down={
"deadzone": 0.5,
"events": [{
"keycode": 65366,
"type": "Key"
}]
}
ui_home={
"deadzone": 0.5,
"events": [{
"keycode": 65360,
"type": "Key"
}]
}
ui_end={
"deadzone": 0.5,
"events": [{
"keycode": 65367,
"type": "Key"
}]
}

[rendering]

renderer/rendering_method="gl_compatibility"
